{
  "expo": {
    "name": "Fame Fleet",
    "slug": "fame-driver",
    "owner": "fame-global",
    "version": "1.3.0",
    "scheme": "famedriver",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f3f2ee",
    "android": {
      "package": "com.fameglobal.driver",
      "adaptiveIcon": {
        "backgroundColor": "#f2a900",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15181c",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/notification-icon.png"
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f2a900",
          "sounds": [
            "./assets/sounds/new_task.wav",
            "./assets/sounds/task_changed.wav",
            "./assets/sounds/general.wav",
            "./assets/sounds/task_ring.ogg",
            "./assets/sounds/task_update.ogg",
            "./assets/sounds/office_ask.ogg"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "si"
          ]
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      "expo-file-system",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.rnmlkit.** { *; }"
          }
        }
      ],
      "./plugins/withMlKitFromPlayServices",
      "./plugins/withKeptSounds",
      "expo-asset",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-background-task",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "extra": {
      "privacyUrl": "https://fame-fleet.pages.dev/privacy",
      "supabaseUrl": "https://hinurfsaxvplbyqgtozj.supabase.co",
      "supabasePublishableKey": "sb_publishable_bjJPWylzmSo5OUOiy_IXpQ_p0IzJBIh",
      "router": {},
      "eas": {
        "projectId": "9a4bca33-b483-4f2e-a560-4e818d5ed545"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9a4bca33-b483-4f2e-a560-4e818d5ed545",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    }
  }
}
