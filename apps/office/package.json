{
  "name": "fame-fleet-office",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build",
    "build:artifact": "tsc -p tsconfig.json --noEmit && vite build --mode artifact",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.0"
  }
}
