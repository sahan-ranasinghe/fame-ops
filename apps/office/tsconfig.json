{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node",
      "google.maps"
    ],
    "baseUrl": ".",
    "paths": {
      "@fleet/status": [
        "../../supabase/functions/_shared/fleet/status.ts"
      ],
      "@fleet/route": [
        "../../supabase/functions/_shared/fleet/route.ts"
      ],
      "@fleet/track": [
        "../../supabase/functions/_shared/fleet/track.ts"
      ],
      "@fleet/permissions": [
        "../../supabase/functions/_shared/fleet/permissions.ts"
      ],
      "@fleet/polyline": [
        "../../supabase/functions/_shared/fleet/polyline.ts"
      ],
      "@fleet/names": [
        "../../supabase/functions/_shared/fleet/names.ts"
      ],
      "@fleet/sites": [
        "../../supabase/functions/_shared/fleet/sites.ts"
      ],
      "@fleet/durations": [
        "../../supabase/functions/_shared/fleet/durations.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
